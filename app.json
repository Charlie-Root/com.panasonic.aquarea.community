{
  "id": "com.panasonic.aquarea.community",
  "version": "1.0.2",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#0055A4",
  "name": {
    "en": "Panasonic Aquarea",
    "fr": "Panasonic Aquarea"
  },
  "description": {
    "en": "Your Aquarea heat pump, working smarter with Homey.",
    "fr": "Votre pompe à chaleur Aquarea, pilotée intelligemment par Homey."
  },
  "category": [
    "climate"
  ],
  "tags": {
    "en": [
      "heat pump",
      "aquarea",
      "panasonic",
      "heating",
      "climate"
    ],
    "fr": [
      "pompe a chaleur",
      "aquarea",
      "panasonic",
      "chauffage",
      "climat"
    ]
  },
  "platforms": [
    "local"
  ],
  "permissions": [],
  "author": {
    "name": "Community"
  },
  "contributors": {},
  "support": "https://community.homey.app/",
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "drivers": [
    {
      "id": "aquarea_heatpump",
      "name": {
        "en": "Aquarea Heat Pump",
        "fr": "Pompe a chaleur Aquarea"
      },
      "class": "thermostat",
      "capabilities": [
        "thermostat_mode",
        "target_temperature.zone",
        "target_temperature",
        "onoff.tank",
        "onoff.zone",
        "measure_temperature",
        "measure_temperature.zone",
        "measure_temperature.outdoor"
      ],
      "capabilitiesOptions": {
        "onoff.tank": {
          "title": {
            "en": "Tank (DHW)",
            "fr": "Ballon (ECS)"
          },
          "insightsTitleTrue": {
            "en": "Tank on",
            "fr": "Ballon allume"
          },
          "insightsTitleFalse": {
            "en": "Tank off",
            "fr": "Ballon eteint"
          }
        },
        "onoff.zone": {
          "title": {
            "en": "Heating zone",
            "fr": "Zone de chauffage"
          },
          "insightsTitleTrue": {
            "en": "Zone on",
            "fr": "Zone allumee"
          },
          "insightsTitleFalse": {
            "en": "Zone off",
            "fr": "Zone eteinte"
          }
        },
        "measure_temperature": {
          "title": {
            "en": "Tank temperature",
            "fr": "Temperature ballon"
          }
        },
        "target_temperature": {
          "title": {
            "en": "Tank setpoint",
            "fr": "Consigne ballon"
          },
          "min": 40,
          "max": 65,
          "step": 1,
          "units": {
            "en": "°C",
            "fr": "°C"
          }
        },
        "measure_temperature.zone": {
          "title": {
            "en": "Zone / heating temperature",
            "fr": "Temperature zone / chauffage"
          }
        },
        "target_temperature.zone": {
          "title": {
            "en": "Zone setpoint / curve offset",
            "fr": "Consigne zone / decalage loi d'eau"
          },
          "min": -5,
          "max": 5,
          "step": 1,
          "units": {
            "en": "°C",
            "fr": "°C"
          }
        },
        "thermostat_mode": {
          "title": {
            "en": "Operating mode",
            "fr": "Mode de fonctionnement"
          },
          "values": [
            {
              "id": "auto",
              "title": {
                "en": "Auto",
                "fr": "Auto"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat",
                "fr": "Chauffage"
              }
            },
            {
              "id": "heat_tank",
              "title": {
                "en": "Heat + hot water",
                "fr": "Chauffage + ECS"
              }
            },
            {
              "id": "cool",
              "title": {
                "en": "Cool",
                "fr": "Rafraichissement"
              }
            },
            {
              "id": "off",
              "title": {
                "en": "Off",
                "fr": "Arret"
              }
            }
          ]
        },
        "measure_temperature.outdoor": {
          "title": {
            "en": "Outdoor temperature",
            "fr": "Temperature exterieure"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/aquarea_heatpump/assets/images/small.png",
        "large": "/drivers/aquarea_heatpump/assets/images/large.png",
        "xlarge": "/drivers/aquarea_heatpump/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "logo.png",
            "usernameLabel": {
              "en": "Aquarea Smart Cloud e-mail",
              "fr": "E-mail Aquarea Smart Cloud"
            },
            "passwordLabel": {
              "en": "Password",
              "fr": "Mot de passe"
            }
          },
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Polling",
            "fr": "Interrogation (polling)"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Polling interval (seconds)",
                "fr": "Intervalle d'interrogation (secondes)"
              },
              "hint": {
                "en": "Time between cloud refreshes. Do NOT set this too low: Aquarea Smart Cloud rate-limits requests and may temporarily ban your IP or lock your account. Minimum 60 s, recommended 300 s.",
                "fr": "Delai entre deux rafraichissements. Ne PAS mettre une valeur trop basse : Aquarea Smart Cloud limite le debit et peut bannir temporairement votre IP ou verrouiller le compte. Minimum 60 s, recommande 300 s."
              },
              "value": 300,
              "min": 60,
              "max": 3600,
              "units": {
                "en": "s",
                "fr": "s"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "About / Disclaimer",
            "fr": "A propos / Avertissement"
          },
          "children": [
            {
              "id": "disclaimer",
              "type": "label",
              "label": {
                "en": "Disclaimer",
                "fr": "Avertissement"
              },
              "value": "This is an UNOFFICIAL community app. It is not affiliated with, endorsed by, or supported by Panasonic Corporation. It relies on a private, undocumented API that may change or stop working at any time. Use a DEDICATED secondary Panasonic account shared from your main account to avoid session conflicts. Use at your own risk. / Application NON OFFICIELLE, sans lien avec Panasonic Corporation. Utilisez un compte dedie. Utilisation aux risques de l'utilisateur.",
              "hint": {
                "en": "Community app - not affiliated with Panasonic Corporation.",
                "fr": "Application communautaire - sans lien avec Panasonic Corporation."
              }
            }
          ]
        }
      ]
    }
  ]
}
